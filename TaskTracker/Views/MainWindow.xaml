<Window x:Class="TaskTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TaskTracker.Converters"
        Title="Трекер задач для разработчиков" Height="950" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:PriorityToColorConverter x:Key="PriorityToColor"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Канбан-доска -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- TO DO -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="5" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <Border Background="#FFE5E5" Padding="10" CornerRadius="8,8,0,0">
                        <TextBlock Text="📋 TO DO" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    <ListBox x:Name="TodoListBox" BorderThickness="0" MinHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" CornerRadius="6" Margin="5" Padding="8" BorderBrush="#DDD" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{Binding Priority, Converter={StaticResource PriorityToColor}}" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Deadline, StringFormat=dd.MM.yyyy}" FontSize="10" Foreground="#888" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- IN PROGRESS -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="5" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <Border Background="#FFE5CC" Padding="10" CornerRadius="8,8,0,0">
                        <TextBlock Text="⚙ IN PROGRESS" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    <ListBox x:Name="InProgressListBox" BorderThickness="0" MinHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" CornerRadius="6" Margin="5" Padding="8" BorderBrush="#DDD" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{Binding Priority, Converter={StaticResource PriorityToColor}}" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Deadline, StringFormat=dd.MM.yyyy}" FontSize="10" Foreground="#888" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- DONE -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="5" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <Border Background="#CCFFCC" Padding="10" CornerRadius="8,8,0,0">
                        <TextBlock Text="✅ DONE" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    <ListBox x:Name="DoneListBox" BorderThickness="0" MinHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" CornerRadius="6" Margin="5" Padding="8" BorderBrush="#DDD" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextDecorations="Strikethrough" Foreground="#888" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{Binding Priority, Converter={StaticResource PriorityToColor}}" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">

            <!-- Выбор спринта -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏃 ТЕКУЩИЙ СПРИНТ" FontWeight="Bold" FontSize="14"/>
                    <ComboBox x:Name="SprintComboBox" DisplayMemberPath="Name" Margin="0,5,0,0" SelectionChanged="SprintComboBox_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- Статистика -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 СТАТИСТИКА" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StatsCompleted" FontSize="13" Margin="0,2"/>
                    <TextBlock x:Name="StatsInProgress" FontSize="13" Margin="0,2"/>
                    <TextBlock x:Name="StatsOverdue" FontSize="13" Margin="0,2"/>
                    <TextBlock x:Name="StatsTotal" FontSize="13" Margin="0,2" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Новая задача -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="➕ НОВАЯ ЗАДАЧА" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBox x:Name="NewTaskNameBox" Margin="0,5" Padding="8" Text="Название задачи"/>
                    <ComboBox x:Name="NewTaskPriorityBox" Margin="0,5" SelectedIndex="1">
                        <ComboBoxItem>Низкий</ComboBoxItem>
                        <ComboBoxItem>Средний</ComboBoxItem>
                        <ComboBoxItem>Высокий</ComboBoxItem>
                    </ComboBox>
                    <DatePicker x:Name="NewTaskDeadlinePicker" Margin="0,5"/>
                    <Button Content="Создать задачу" Click="CreateTask_Click" Background="#4CAF50" Foreground="White" Padding="8" Margin="0,10" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Новый спринт -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏃 НОВЫЙ СПРИНТ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBox x:Name="NewSprintNameBox" Margin="0,5" Padding="8" Text="Спринт 1"/>
                    <DatePicker x:Name="NewSprintStartPicker" Margin="0,5"/>
                    <DatePicker x:Name="NewSprintEndPicker" Margin="0,5"/>
                    <Button Content="Создать спринт" Click="CreateSprint_Click" Background="#2196F3" Foreground="White" Padding="8" Margin="0,10" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- ПЕРЕМЕЩЕНИЕ ЗАДАЧИ -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🚚 ПЕРЕМЕЩЕНИЕ ЗАДАЧИ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Выберите задачу:" FontSize="12" Margin="0,5,0,0"/>
                    <ComboBox x:Name="TaskSelector" DisplayMemberPath="Name" Margin="0,5,0,10" SelectionChanged="TaskSelector_SelectionChanged"/>

                    <TextBlock Text="Выберите новую колонку:" FontSize="12" Margin="0,5,0,0"/>
                    <ComboBox x:Name="ColumnSelector" Margin="0,5,0,10" SelectedIndex="0">
                        <ComboBoxItem>To Do</ComboBoxItem>
                        <ComboBoxItem>In Progress</ComboBoxItem>
                        <ComboBoxItem>Done</ComboBoxItem>
                    </ComboBox>

                    <Button x:Name="MoveTaskButton" 
                            Content="Переместить задачу" 
                            Click="MoveTask_Click"
                            Background="#FF9800" 
                            Foreground="White" 
                            FontWeight="Bold"
                            Padding="8" 
                            Margin="0,0,0,10"
                            Cursor="Hand"/>

                    <TextBlock x:Name="SelectedTaskInfo" 
                               Text="✏️ Выберите задачу и колонку для перемещения"
                               Foreground="Gray" 
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>